
<div class="min-h-screen flex items-center justify-center">

  <div class="w-full max-w-sm sm:max-w-sm md:max-w-md lg:max-w-lg mx-auto my-auto p-6 bg-white rounded-xl shadow-md ">
    <h2 class="text-center text-2xl font-bold text-[#2563EB] m-2">Expense Tracker</h2>
    <h2 class="text-center text-xl font-bold m-2">Log in</h2>

    
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

      <div class="flex flex-col gap-4 items-center text-center">


          <div class="field w-full">
            <p><%= f.label :email, class:"flex" %></p>
            <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full border h-[42px]" %></p>
          </div>

          <div class="field w-full">
            <p><%= f.label :password, class:"flex" %></p>
            <p><%= f.password_field :password, autocomplete: "current-password", class: "w-full border h-[42px]" %></p>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="field flex items-center justify-center gap-2">
              <%= f.check_box :remember_me %>
              <%= f.label :remember_me %>
            </div>
          <% end %>

          <div class="actions flex text-white actions h-[42px] w-full bg-[#2563EB] justify-center item-center">
            <%= f.submit "Log in" %>
          </div>
        <% end %>

        <%= render "devise/shared/links" %>
      </div>

  </div>
</div>
