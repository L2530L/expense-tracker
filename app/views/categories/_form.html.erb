<%= form_with(model: category, class: "space-y-4") do |form| %>
  <div>
    <%= form.label :name, "Category Name", class: "block text-sm font-medium text-gray-700" %>

    <%= form.text_field :name,
        placeholder: "e.g. Health",
        required: true,
        class: "w-full p-2 border rounded mt-1 outline-none focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div class="pt-4 flex flex-col gap-2">
    <%= form.submit category.persisted? ? "Update" : "Create",
        class: "w-full bg-blue-600 text-white py-2 rounded font-bold hover:bg-blue-700 cursor-pointer" %>

    <%= link_to "Go back",
        categories_path,
        class: "text-center py-2 text-gray-500 text-sm hover:underline" %>
  </div>
<% end %>