<% content_for :title, "Categories" %>


<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-6">
  <div class="flex justify-between items-center py-6">
    <h1 class="text-4xl font-bold">Manage Categories</h1>
    <%= link_to "New category", new_category_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>


  <div class="flex flex-col w-full border border-gray-300 rounded-lg overflow-hidden">
    <% if @categories.any? %>
      <% @categories.each do |category| %>
      
      <div class="flex justify-between p-2 border-b last:border-b-0 border-gray-300">
        <div class=" sm:flex-row justify-between items-center pb-5 sm:pb-0 text-xl">
          <%= category["name"]%>
        </div>

        <div class="w-full sm:w-auto flex sm:flex-row space-x-2 space-y-2 ">
          <%= link_to "Edit", edit_category_path(category), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
          <%= button_to "Delete", category, method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
        </div>

      </div>
      <%end%>
    <%end%>
  </div>
</div>