```erb
<% content_for :title, @expense.title %>

<div class="max-w-3xl mx-auto bg-white rounded-xl shadow-sm border border-gray-200 p-8">

  <div class="flex items-center justify-between mb-8">
    <div>
      <p class="text-sm text-gray-500">Expense Details</p>
      <h1 class="text-3xl font-bold text-gray-900">
        <%= @expense.title %>
      </h1>
    </div>

    <span class="text-2xl font-bold text-red-600">
      -<%= number_to_currency(@expense.amount) %>
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <div>
      <p class="text-sm text-gray-500">Category</p>
      <p class="mt-1 font-medium text-gray-900">
        <%= @expense.category.name %>
      </p>
    </div>

    <div>
      <p class="text-sm text-gray-500">Expense Date</p>
      <p class="mt-1 font-medium text-gray-900">
        <%= @expense.expense_date.strftime("%B %d, %Y") %>
      </p>
    </div>

    <div class="md:col-span-2">
      <p class="text-sm text-gray-500">Notes</p>

      <% if @expense.note.present? %>
        <p class="mt-1 text-gray-700 whitespace-pre-line">
          <%= @expense.note %>
        </p>
      <% else %>
        <p class="mt-1 italic text-gray-400">
          No notes added.
        </p>
      <% end %>
    </div>

  </div>

  <div class="flex gap-3 mt-10 border-t pt-6">

    <%= link_to "Back",
        expenses_path,
        class: "px-4 py-2 rounded-lg border border-gray-300 hover:bg-gray-100" %>

    <%= link_to "Edit",
        edit_expense_path(@expense),
        class: "px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700" %>

    <%= button_to "Delete",
        @expense,
        method: :delete,
        class: "px-4 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700 cursor-pointer",
        data: { turbo_confirm: "Are you sure you want to delete this expense?" } %>

  </div>

</div>
```
