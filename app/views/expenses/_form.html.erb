<%= form_with(model: expense, class: "max-w-md mx-auto mt-10 px-6") do |form| %>



  <div class="bg-white p-6 rounded shadow-sm border">
    <h1 class="text-xl font-bold mb-6 text-gray-700">
      <%= expense.persisted? ? "Edit Expense" : "Add New Expense" %>
    </h1>

    <% if expense.errors.any? %>
      <div class="bg-red-50 text-red-600 p-3 rounded mb-6">
        <h2 class="font-semibold mb-2">
          <%= pluralize(expense.errors.count, "error") %> prohibited this expense from being saved:
        </h2>

        <ul class="list-disc ml-5">
          <% expense.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-2">

      <div>
        <%= form.label :title, class: "block text-xs font-bold text-gray-500 uppercase tracking-wide" %>
        <%= form.text_field :title,
          placeholder: "e.g. Lunch",
          class: "w-full p-2 border rounded mt-1 focus:border-blue-500 outline-none #{expense.errors[:title].any? ? 'border-red-400' : 'border-gray-300'}" %>
      </div>

      <div>
        <%= form.label :amount, class: "block text-xs font-bold text-gray-500 uppercase tracking-wide" %>
        <%= form.number_field :amount,
          step: 0.01,
          placeholder: "0.00",
          class: "w-full p-2 border rounded mt-1 focus:border-blue-500 outline-none #{expense.errors[:amount].any? ? 'border-red-400' : 'border-gray-300'}" %>
      </div>

      <div>
        <%= form.label :expense_date, "Date", class: "block text-xs font-bold text-gray-500 uppercase tracking-wide" %>
        <%= form.date_field :expense_date,
          class: "w-full p-2 border rounded mt-1 focus:border-blue-500 outline-none #{expense.errors[:expense_date].any? ? 'border-red-400' : 'border-gray-300'}" %>
      </div>

      <div>
        <%= form.label :category_id, "Category", class: "block text-xs font-bold text-gray-500 uppercase tracking-wide" %>
        <%= form.collection_select :category_id,
            Category.order(:name),
            :id,
            :name,
            { prompt: "Select a category" },
            { class: "w-full p-2 border rounded mt-1 bg-white focus:border-blue-500 outline-none #{expense.errors[:category_id].any? ? 'border-red-400' : 'border-gray-300'}" } %>
      </div>

      <div>
        <%= form.label :note, class: "block text-xs font-bold text-gray-500 uppercase tracking-wide" %>
        <%= form.text_area :note,
          rows: 4,
          placeholder: "Optional notes...",
          class: "w-full p-2 border rounded mt-1 focus:border-blue-500 outline-none #{expense.errors[:note].any? ? 'border-red-400' : 'border-gray-300'}" %>
      </div>

      <%= form.submit expense.persisted? ? "Update Expense" : "Save Expense",
          class: "w-full bg-blue-600 text-white py-2 rounded font-bold hover:bg-blue-700 cursor-pointer mt-4" %>

      <%= link_to "Cancel", expenses_path,
          class: "block text-center text-gray-500 text-sm mt-2 hover:underline" %>

    </div>
  </div>

<% end %>