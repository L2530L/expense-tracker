<div id="<%= dom_id expense %>" class="w-full sm:w-auto my-5 space-y-5">


  <ul class="flex gap-5 ">
    <li>
      <div>
        <strong class="block font-medium mb-1 ">Title:</strong>
        <%= expense.title %>
      </div>
      
    </li>
    <li>
      <div>
        <strong class="block font-medium mb-1 bg-red">Amount:</strong>
        <%=  expense.amount %>
      </div>

    </li>
  <li>
    <div>
      <strong class="block font-medium mb-1">Expense date:</strong>
      <%= expense.expense_date %>
    </div>
  </li>

  <li>

    <div>
      <strong class="block font-medium mb-1">Note:</strong>
      <%= expense.note %>
    </div>
  </li>

  </ul>
  
</div>
